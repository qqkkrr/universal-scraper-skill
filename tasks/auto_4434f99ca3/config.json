{
  "name": "auto_4434f99ca3",
  "intent": {
    "target_type": "软件/开源项目",
    "entry_rationale": "GitHub Trending 是 GitHub 官方热门仓库列表页，SSR 可直接抓取，作为『抓取例子』任务的演示入口",
    "expected_fields": [
      "仓库名",
      "仓库链接",
      "描述",
      "今日star数"
    ]
  },
  "start_urls": [
    "https://github.com/trending"
  ],
  "queue": {
    "max_depth": 1,
    "max_requests": 10,
    "max_concurrency": 2
  },
  "source": {
    "type": "browser",
    "headless": true,
    "scroll_count": 4,
    "scroll_wait_ms": 800,
    "record_from": "capture_all",
    "capture_all": true,
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
    }
  },
  "rules": [
    {
      "match": "contains",
      "pattern": "/trending",
      "parser": "list"
    }
  ],
  "parsers": {
    "list": {
      "type": "html",
      "row_css": "article.Box-row",
      "fields": {
        "repo": {
          "css": "h2 a:first-of-type::text"
        },
        "link": {
          "css": "h2 a:first-of-type::attr(href)"
        },
        "description": {
          "css": "p.col-9::text"
        },
        "stars_today": {
          "css": "span.d-inline-block.float-sm-right::text"
        }
      }
    },
    "default": {
      "type": "html",
      "row_css": "article.Box-row",
      "fields": {
        "repo": {
          "css": "h2 a:first-of-type::text"
        },
        "link": {
          "css": "h2 a:first-of-type::attr(href)"
        },
        "description": {
          "css": "p.col-9::text"
        },
        "stars_today": {
          "css": "span.d-inline-block.float-sm-right::text"
        }
      }
    }
  },
  "pipelines": [
    {
      "type": "filter",
      "field": "repo",
      "op": "non_empty"
    },
    {
      "type": "dedup",
      "key": "repo"
    }
  ],
  "storage": {
    "type": "jsonl",
    "name": "auto_4434f99ca3"
  },
  "output": {
    "dir": "outputs",
    "base_name": "auto_4434f99ca3"
  },
  "anti_bot": {
    "min_interval": 0.5,
    "max_retries": 2
  }
}