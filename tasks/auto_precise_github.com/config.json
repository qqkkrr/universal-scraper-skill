{
  "name": "github_trending",
  "source": {
    "type": "http",
    "headless": false
  },
  "rules": [
    {
      "match": "contains",
      "pattern": "/trending",
      "parser": "parse_trending"
    }
  ],
  "parsers": {
    "parse_trending": {
      "type": "html",
      "row_css": "article.Box-row",
      "fields": {
        "title": {
          "css": "h2 a"
        },
        "link": {
          "css": "h2 a",
          "attr": "href"
        },
        "description": {
          "css": "p"
        },
        "language": {
          "css": "[itemprop='programmingLanguage']"
        },
        "stars": {
          "css": "a[href$='/stargazers']"
        },
        "forks": {
          "css": "a[href$='/forks']"
        }
      },
      "extract_links": {
        "allow": "^/.*",
        "same_domain": true
      }
    }
  },
  "pipelines": [
    {
      "type": "dedup",
      "key": "link"
    }
  ],
  "detail": {
    "enabled": false
  },
  "storage": {
    "type": "jsonl",
    "name": "github_trending"
  },
  "output": {
    "dir": "outputs",
    "base_name": "github_trending"
  },
  "start_urls": [
    "https://github.com/trending"
  ],
  "queue": {
    "max_depth": 2,
    "max_requests": 100,
    "max_concurrency": 2
  },
  "anti_bot": {
    "min_interval": 0.5,
    "max_retries": 2
  }
}